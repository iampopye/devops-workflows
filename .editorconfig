# Keeps contributions consistent without anyone having to think about it.
# Most editors support this natively; some need a plugin.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown, so don't strip them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
